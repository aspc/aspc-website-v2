# Copy to .env and fill in. Loaded via dotenv on server startup.

# --- Core ---
NODE_ENV=development
PORT=4000
FRONTEND_LINK=http://localhost:3000
SESSION_SECRET=change-me

# --- MongoDB ---
MONGODB_TEST_URI=mongodb://localhost:27017/aspc-dev
MONGODB_URI_PROD=
MONGODB_URI=

# --- SAML SSO (Pomona) ---
ENTITY_ID=
IDP_METADATA_URL=

# --- Course catalog API ---
COURSE_API_KEY=

# --- Campus Labs Engage (events) ---
ENGAGE_API_URL=
ENGAGE_API_KEY=

# --- Ride matching (ML microservice) ---
# URL of the deployed ml_microservice (see /ml_microservice in the AlgModel
# project). Optional: the "Rides" admin tab just shows "not configured" if
# this is unset, the rest of the backend is unaffected either way.
ML_SERVICE_URL=http://localhost:8000
# Only needed if the microservice was deployed with SERVICE_API_KEY set.
ML_SERVICE_API_KEY=
