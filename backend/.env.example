# Copy to .env and fill in. Loaded via dotenv on server startup.

# --- Core ---
NODE_ENV=development
PORT=5000
FRONTEND_LINK=http://localhost:3001
SESSION_SECRET=change-me

# --- MongoDB ---
MONGODB_TEST_URI=mongodb://localhost:27017/aspc-dev
MONGODB_URI_PROD=
MONGODB_URI=

# --- SAML SSO (Pomona) ---
ENTITY_ID=
IDP_METADATA_URL=

# --- Course catalog API ---
COURSE_API_KEY=

# --- Campus Labs Engage (events) ---
ENGAGE_API_URL=
ENGAGE_API_KEY=

# --- Ride-matching ML service (ml_microservice/, deployed as a second
# container in this same Lightsail service — reachable at localhost, not
# public on its own). /api/ml/* on this backend is the one public door to
# it, for external callers like p-ickup/frontend. ---
ML_SERVICE_URL=http://localhost:8000
# Sent as X-API-Key when this backend calls ml-service internally. Must
# match SERVICE_API_KEY in ml_microservice/.env.
ML_SERVICE_API_KEY=
# Sent as X-API-Key by external callers (e.g. p-ickup/frontend) hitting
# POST /api/ml/match on *this* backend. Different key from the one above —
# this one guards the public door, that one guards the internal hop.
ML_PROXY_API_KEY=
