# Copy this file to .env and fill in your values. Loaded automatically on
# startup via python-dotenv. Both are optional — without them, /match still
# works as long as callers always pass "riders" directly in the request body.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-service-role-or-secret-key

# Optional: require callers to send a matching "X-API-Key" header on /match.
# Leave unset for frictionless local dev. Set this in any deployment the
# aspc-website-v2 backend will call, and set ML_SERVICE_API_KEY to the same
# value in that backend's .env.
SERVICE_API_KEY=
